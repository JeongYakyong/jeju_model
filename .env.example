# jeju_model 환경변수 견본
# ─────────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 값을 채운다:
#     cp .env.example .env && nano .env && chmod 600 .env
# .env 는 git 에 올라가지 않는다(.gitignore). 서버마다 직접 만들어야 한다.
# 값에 따옴표는 붙이지 않는다.  KEY=값  형식 그대로.
# ─────────────────────────────────────────────────────────────────

# ── KMA API 허브 키 (필수) ────────────────────────────────────────
# 기상예보(KIMR/KIMG)와 ASOS 실측을 받는다.  https://apihub.kma.go.kr
# 이 키가 없으면 예보·실측 수집이 통째로 멈춘다.
KMA_API_KEY=

# 예비 키 (선택 — 있으면 넣는 편이 좋다).
# 쓰던 키가 일일 한도 초과 응답을 내는 순간 다음 키로 자동 전환한다
# (KMA_API_KEY → SUB → SUB2 → SUB3).  빈 줄로 두면 그냥 건너뛴다.
KMA_API_KEY_SUB=
KMA_API_KEY_SUB2=
KMA_API_KEY_SUB3=

# ── KPX 전력수급 OpenAPI 키 (필수) ────────────────────────────────
# 제주 수급 실측 + 하루전(DA)·실시간(RT) SMP.  https://www.data.go.kr
# 이 키가 없으면 historical 이 안 쌓이고, 뒤이어 예측·SMP 가 전부 막힌다.
KPX_API_KEY=

# ── Gemini API 키 (선택) ──────────────────────────────────────────
# 화면의 AI 브리핑 생성에만 쓴다.
# 없으면 브리핑만 비활성이고 수집·예측·차트는 정상 동작한다.
GEMINI_API_KEY=

# ── 관리자 메뉴 비밀번호 (외부 공개 서버는 필수) ──────────────────
# 화면 '관리자' 탭(수집·예측 수동 실행, 보정표 재적합) 게이트.
# ★ 비워 두면 기본값 "8888" 로 열린다 — 반드시 지정할 것.
OPS_PASSWORD=
