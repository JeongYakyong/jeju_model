# .streamlit/secrets.toml 견본
# ─────────────────────────────────────────────────────────────────
# 이 파일을 secrets.toml 로 복사한 뒤 값을 채운다:
#     cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#     nano .streamlit/secrets.toml && chmod 600 .streamlit/secrets.toml
# secrets.toml 은 git 에 올라가지 않는다(.gitignore).
#
# 화면 첫 진입의 비밀번호 게이트에 쓴다(app.py).
# 통과하면 루트에 .auth_token 이 생기고 6시간 동안 유지된다.
# 관리자 탭은 이것과 별개로 .env 의 OPS_PASSWORD 를 한 번 더 묻는다.
# ─────────────────────────────────────────────────────────────────

password = "여기에_화면_접속_비밀번호"
